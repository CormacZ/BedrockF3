# Normalize line endings to LF, except for Windows-specific files.
*                 text=auto eol=lf

# Shell scripts must use LF
*.sh              text eol=lf

# Batch files must use CRLF
*.bat             text eol=crlf
*.cmd             text eol=crlf

# Windows binary files
*.dll             binary
*.exe             binary
*.pdb             binary
